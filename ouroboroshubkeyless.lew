-- Hiệu ứng lắc khung khi sai Key
local function ShakeFrame()
    local originalPos = UDim2.new(0.5, -190, 0.5, -122)
    local intensity = 8
    
    task.spawn(function()
        for i = 1, 4 do
            TweenService:Create(MainFrame, TweenInfo.new(0.04), {Position = originalPos + UDim2.new(0, intensity, 0, 0)}):Play()
            task.wait(0.04)
            TweenService:Create(MainFrame, TweenInfo.new(0.04), {Position = originalPos + UDim2.new(0, -intensity, 0, 0)}):Play()
            task.wait(0.04)
            intensity = intensity * 0.6
        end
        TweenService:Create(MainFrame, TweenInfo.new(0.05), {Position = originalPos}):Play()
    end)
end

-- 4. Xử lý logic Key
local CORRECT_KEY = "OuroborosHubKeyNalwkwj - Lappqjwnlaiowpje"

SubmitBtn.MouseButton1Click:Connect(function()
    if TextBox.Text == CORRECT_KEY then
        ErrorLabel.TextColor3 = Color3.fromRGB(120, 255, 140)
        ErrorLabel.Text = "Success! Loading..."
        
        -- Lưu vào file thật để nhớ suốt 24 giờ (kể cả khi đổi server/thoát game)
        SaveKey()
        
        -- Hiệu ứng ẩn mượt mà
        TweenService:Create(MainFrame, TweenInfo.new(0.3), {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)}):Play()
        TweenService:Create(Overlay, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        task.wait(0.35)
        ScreenGui:Destroy()
        
        -- Chạy script chính
        local success, err = pcall(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/joustingmatch/Ouroboros/main/loader.lua"))()
        end)
        if not success then
            warn("Error loading main script: " .. tostring(err))
        end
    else
        ErrorLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        ErrorLabel.Text = "Incorrect key! Please try again."
        ShakeFrame()
        TextBox.Text = "" -- Xoá trắng ô khi nhập sai
    end
end)

GetKeyBtn.MouseButton1Click:Connect(function()
    setclipboard("https://link4m.org/axptXJ")
    
    local requestFunc = syn and syn.request or http and http.request or http_request or request
    if requestFunc then
        pcall(function()
            requestFunc({
                Url = "https://link4m.org/axptXJ",
                Method = "GET"
            })
        end)
    end
    
    ErrorLabel.TextColor3 = Color3.fromRGB(255, 182, 193)
    ErrorLabel.Text = "Link copied to clipboard!"
end)
