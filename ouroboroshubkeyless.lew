-- 1. Khởi tạo dịch vụ & Cấu hình File lưu Key
local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local Player = Players.LocalPlayer

local KEY_FILE = "OuroborosHub_KeyData.json"
local EXPIRE_TIME = 86400 -- 24 giờ tính bằng giây (24 * 60 * 60)

-- Hàm kiểm tra xem Key đã lưu còn hạn 24h hay không
local function HasValidKey()
    if not (isfile and readfile) then return false end
    if isfile(KEY_FILE) then
        local success, data = pcall(function()
            return game:GetService("HttpService"):JSONDecode(readfile(KEY_FILE))
        end)
        if success and type(data) == "table" and data.ExpiryTime then
            -- So sánh thời gian hiện tại với thời gian lưu (os.time() trả về giây thực tế)
            if os.time() < data.ExpiryTime then
                return true
            end
        end
    end
    return false
end

-- Hàm lưu thời gian hết hạn (24 giờ sau)
local function SaveKey()
    if writefile and game:GetService("HttpService") then
        local data = {
            ExpiryTime = os.time() + EXPIRE_TIME
        }
        pcall(function()
            writefile(KEY_FILE, game:GetService("HttpService"):JSONEncode(data))
        end)
    end
end

-- 2. Tự động bỏ qua bảng Key nếu đã lưu trong vòng 24 giờ
if HasValidKey() then
    local success, err = pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/joustingmatch/Ouroboros/main/loader.lua"))()
    end)
    if not success then
        warn("Error loading main script: " .. tostring(err))
    end
    return
end

